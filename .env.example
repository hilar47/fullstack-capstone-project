# Copy this file to .env and fill in real values. Never commit the real .env file.

# MongoDB connection string
# Local example:   mongodb://localhost:27017
# Atlas example:   mongodb+srv://<user>:<password>@<cluster>.mongodb.net
MONGO_URL=mongodb://localhost:27017

# Secret used to sign JWTs - use a long random string
JWT_SECRET=change_this_to_a_long_random_secret

# Port the backend listens on
PORT=3060
